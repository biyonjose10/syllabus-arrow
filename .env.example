# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these under Project → Settings → Environment Variables.

# ── Database (added automatically when Neon is connected in Vercel Storage) ──
# Pooled URL, used by the app.
DATABASE_URL=
# Unpooled URL, used only by `prisma migrate` / `db push`.
DATABASE_URL_UNPOOLED=

# ── Auth ────────────────────────────────────────────────────────────────────
# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# http://localhost:3000 locally; the production URL on Vercel.
BETTER_AUTH_URL=

# Google sign-in (Google Cloud project `syllabus-arrow` → Clients → Web app).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (Gmail SMTP, app password — needs 2-Step Verification) ───────────
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── AI ──────────────────────────────────────────────────────────────────────
# Deliberately NOT GEMINI_API_KEY: an inherited environment variable of that
# name always beats this file, and on the dev machine it is a different, paid key.
SYLLABUS_GEMINI_KEY=

# ── Storage (added automatically when Blob is connected in Vercel Storage) ──
BLOB_READ_WRITE_TOKEN=

# ── Background jobs (added automatically by the Inngest Vercel integration) ─
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set to 1 locally to use `npx inngest-cli@latest dev` instead of Inngest Cloud.
INNGEST_DEV=

# ── Billing (Polar sandbox) ─────────────────────────────────────────────────
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRO_PRODUCT_ID=
